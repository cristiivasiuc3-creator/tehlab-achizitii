# Copiază acest fișier ca .env și completează valorile.

# Parola pentru acces în dashboard (OBLIGATORIU dacă publici aplicația pe internet).
# Dacă rămâne goală, aplicația rulează fără autentificare (mod local).
ADMIN_PASSWORD=

# Cheie secretă pentru sesiuni (generează: python3 -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# Portul pe care ascultă serverul
PORT=5000

# Interval de actualizare automată (ore). 48 = o dată la 2 zile.
REFRESH_INTERVAL_HOURS=48
ENABLE_SCHEDULER=1

# Notificări pe email la achiziții noi (opțional — goale = dezactivat)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# lista destinatarilor, separați prin virgulă
EMAIL_TO=cristi.ivasiuc3@gmail.com

# Ajustări colector (rareori e nevoie să le schimbi)
MAX_PAGES_PER_KEYWORD=8
MAX_TENDER_AGE_DAYS=60
DELAY_SECONDS=0.8
